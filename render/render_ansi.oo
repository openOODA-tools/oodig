// # Render ANSI Color Palette
//
// Logline: ANSI color codes and semantic style decorators for terminal DNS query inspection.
//
// Setup: Exports styling tokens for comments, domain names, record types, IP addresses, and flags.
//
// Beats:
//   1. Resolve terminal color capability based on color mode and environment.
//   2. Define semantic color escape sequences (cyan, green, yellow, magenta, reset).
//   3. Wrap domain names, record types, and answer addresses in color decorators.
//   4. Format colored section headers and status badges.

pub fn ansi_reset() -> String { return "\x1b[0m"; }
pub fn ansi_bold() -> String { return "\x1b[1m"; }
pub fn ansi_dim() -> String { return "\x1b[2m"; }
pub fn ansi_red() -> String { return "\x1b[31m"; }
pub fn ansi_green() -> String { return "\x1b[32m"; }
pub fn ansi_yellow() -> String { return "\x1b[33m"; }
pub fn ansi_blue() -> String { return "\x1b[34m"; }
pub fn ansi_magenta() -> String { return "\x1b[35m"; }
pub fn ansi_cyan() -> String { return "\x1b[36m"; }

pub fn style_domain(text: String, enable_color: Bool) -> String {
    if !enable_color { return text; }
    return ansi_bold() + ansi_cyan() + text + ansi_reset();
}

pub fn style_type(text: String, enable_color: Bool) -> String {
    if !enable_color { return text; }
    return ansi_bold() + ansi_yellow() + text + ansi_reset();
}

pub fn style_data(text: String, enable_color: Bool) -> String {
    if !enable_color { return text; }
    return ansi_green() + text + ansi_reset();
}

pub fn style_header(text: String, enable_color: Bool) -> String {
    if !enable_color { return text; }
    return ansi_bold() + ansi_magenta() + text + ansi_reset();
}

pub fn style_comment(text: String, enable_color: Bool) -> String {
    if !enable_color { return text; }
    return ansi_dim() + text + ansi_reset();
}

pub fn color_enabled(color_mode: String, no_color_set: Bool) -> Bool {
    if color_mode == "never" { return false; }
    if color_mode == "always" { return true; }
    if no_color_set { return false; }
    return true;
}
